# Copy this file to .env (same folder) and fill in what you use.
# .env is gitignored -- never commit real credentials.
#
# Each block below is used automatically once you pick that engine at the
# "Engine (snowflake / postgres / redshift)" prompt -- for BOTH BEFORE and
# AFTER independently. Any field left blank/missing just falls back to the
# normal interactive prompt. Engine, Database, Schema, and Table are always
# prompted interactively -- there is no env var for those.

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=

REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_USER=
REDSHIFT_PASSWORD=

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
